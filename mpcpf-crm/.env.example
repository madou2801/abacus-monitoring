# MPCPF CRM — secrets des edge functions Supabase.
# Injecter via : supabase secrets set --env-file .env

# Supabase (injectés automatiquement dans les edge functions déployées)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...

# Retell — clé API servant à vérifier la signature des webhooks (x-retell-signature)
RETELL_API_KEY=key_xxx
RETELL_VERIFY_SIGNATURE=true
# Optionnel : rappels sortants automatiques
RETELL_FROM_NUMBER=+33180001122
RETELL_AGENT_ID=agent_xxx

# Wedof — secret partagé attendu dans x-wedof-signature (ou Authorization: Bearer)
WEDOF_WEBHOOK_SECRET=change_me
WEDOF_VERIFY_SIGNATURE=true

# Email sortant (relances) — optionnel
RESEND_API_KEY=

# Notifications SMS + email (parcours) — Brevo. Si absent : mise en file (QueueNotifier).
BREVO_API_KEY=
BREVO_SENDER_NAME=MonPermisCPF
BREVO_SENDER_EMAIL=contact@monpermiscpf.com
BREVO_SMS_SENDER=MonPermis

# API parcours (intake-api) — secret partagé attendu en Authorization: Bearer
INTAKE_API_SECRET=change_me
