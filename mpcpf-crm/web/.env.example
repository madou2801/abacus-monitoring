# Super-CRM web — variables SERVEUR uniquement (jamais exposées au navigateur).
# La clé service_role ne doit vivre que côté serveur (Server Components / API routes).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Validation de devis en 1 clic — secret serveur uniquement (jamais NEXT_PUBLIC_*).
INTAKE_API_URL=https://<ref>.supabase.co/functions/v1/intake-api
INTAKE_API_SECRET=
