# Clés du cerveau JARVIS — À COPIER vers .env (jamais committé) et remplir.
# cp .env.example .env  puis  export $(grep -v '^#' .env | xargs)

# Couche réflexe — GLM (z.ai). Créer/récupérer la clé sur https://z.ai
GLM_API_KEY=

# Couche profonde — Claude (Anthropic). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option : router le réflexe par ton LLM Router interne (VPS:3800) au lieu de z.ai direct.
# Dans ce cas, mets baseUrl du "reflex" dans config.json vers ton router (API compatible OpenAI)
# et renseigne ici la clé attendue par le router.
# LLM_ROUTER_URL=http://127.0.0.1:3800

# Option : URL du health-report pour l'outil infra_health (défaut 127.0.0.1:3850).
# HEALTH_REPORT_URL=http://127.0.0.1:3850/health-report
# HEALTH_API_KEY=

# Option : emplacement du store mémoire (défaut : jarvis/brain/memory.store.json)
# JARVIS_MEMORY_PATH=
