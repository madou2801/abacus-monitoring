# ─────────────────────────────────────────────────────────────
# AbacusPay — configuration
# Copiez ce fichier en `.env` et renseignez les valeurs.
# ─────────────────────────────────────────────────────────────

# Serveur
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Clés API marchand (séparées par des virgules) au format "sk_xxx".
# Toute requête vers l'API doit présenter: Authorization: Bearer <clé>
# Générez une clé forte: openssl rand -hex 32
MERCHANT_API_KEYS=sk_test_changeme

# Secret pour signer les webhooks SORTANTS envoyés aux marchands (HMAC-SHA256).
# openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=whsec_changeme

# ── Fournisseur: LigDiCash ───────────────────────────────────
# Laissez LIGDICASH_MOCK=true pour développer sans vraies clés
# (le provider simule les réponses de façon déterministe).
LIGDICASH_MOCK=true
LIGDICASH_BASE_URL=https://app.ligdicash.com/pay/v01
LIGDICASH_API_KEY=
LIGDICASH_API_TOKEN=
# Secret partagé pour vérifier les webhooks ENTRANTS de LigDiCash.
LIGDICASH_WEBHOOK_SECRET=

# URL publique de cette API (pour construire les callbacks fournisseurs)
PUBLIC_BASE_URL=http://localhost:4000
